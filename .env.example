# ---- Banco de dados (Postgres / Supabase) ----
# Supabase: Project Settings > Database > Connection string (URI). Use a porta 5432
# (ou a 6543 do pooler). Ex.:
# DATABASE_URL=postgresql://postgres:SENHA@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=

# SSL do banco. Deixe em branco para SSL (padrão em nuvem). Use "disable" só em
# Postgres local sem SSL.
DATABASE_SSL=

# ---- Pix ----
# "dev"          = sem cobrança real, confirma pagamento sozinho (para testar).
# "mercadopago"  = cobrança Pix real via Mercado Pago (dinheiro cai na sua conta MP).
PIX_PROVIDER=dev

# Access Token do Mercado Pago (obrigatório se PIX_PROVIDER=mercadopago).
# Pegue em https://www.mercadopago.com.br/developers > Suas integrações > credenciais.
# Use as credenciais de PRODUÇÃO para cobrar de verdade. NÃO comite este valor.
MERCADOPAGO_ACCESS_TOKEN=

# URL pública do webhook (opcional). Se vazio, usa NEXT_PUBLIC_BASE_URL + /api/pix/webhook.
# Ex.: https://acaipremiado.vercel.app/api/pix/webhook
PIX_WEBHOOK_URL=

# Valor da ficha em reais.
VALOR_FICHA=2.00

# ---- Cron ----
# Segredo que protege /api/cron/fechar-ciclo. O Vercel Cron envia como
# Authorization: Bearer <CRON_SECRET>. Gere um valor aleatório longo.
CRON_SECRET=

# ---- URL pública (para montar links de QR, opcional) ----
NEXT_PUBLIC_BASE_URL=http://localhost:3000
